# Copy to .env and fill in. Never commit .env.

# LLM provider: openai | anthropic
LLM_PROVIDER=openai
# Used automatically when the primary provider fails. Set to "none" to disable.
LLM_FALLBACK_PROVIDER=anthropic

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Market data and news
ALPHA_VANTAGE_API_KEY=
TAVILY_API_KEY=

# Load the embedding model from the local cache only (no Hugging Face Hub calls).
# The first time, run `HF_HUB_OFFLINE=0 python scripts/build_index.py` to download it.
HF_HUB_OFFLINE=1

# MCP server, Streamable HTTP transport (python -m src.mcp_server --http).
# A long random secret; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_TOKEN=

# Only for refreshing data/reference/sec_company_tickers.json with
# scripts/update_sec_tickers.py: the SEC asks automated tools to give a contact email.
SEC_CONTACT_EMAIL=

# Optional overrides
# FINNIE_CONFIG=config.yaml
